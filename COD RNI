% QPSK, 16-QAM and 64-QAM comparison over AWGN
clear; clc; close all;
rng(7);

Mset  = [4 16 64];
names = {'QPSK','16-QAM','64-QAM'};
col   = {'b','g','r'};
mk    = {'o','s','^'};
EbN0dB = 0:2:20;
targetErrs = 300; maxBits = 2e6;

% theoretical BER, Eq. (3)
Q  = @(x) 0.5*erfc(x/sqrt(2));
Pb = @(M,ebn0) (4/log2(M))*(1-1/sqrt(M))*Q(sqrt(3*log2(M)*ebn0/(M-1)));

%% Fig. 1 - ideal constellations
figure;
for ii = 1:3
    M = Mset(ii);
    pts = qammod((0:M-1)', M, 'UnitAveragePower', true);
    subplot(1,3,ii);
    plot(real(pts), imag(pts), 'o', 'MarkerFaceColor', 'b');
    axis equal; grid on;
    xlabel('In-phase'); ylabel('Quadrature');
    title(sprintf('%s (%d points)', names{ii}, M));
end

%% Fig. 2 - noisy samples, same noise (SNR = 15 dB) for all
figure;
for ii = 1:3
    M = Mset(ii); k = log2(M);
    pts = qammod((0:M-1)', M, 'UnitAveragePower', true);
    b  = randi([0 1], 1200*k, 1);
    tx = qammod(b, M, 'InputType','bit', 'UnitAveragePower', true);
    rx = awgn(tx, 15, 'measured');
    subplot(1,3,ii);
    plot(real(rx), imag(rx), '.'); hold on;
    plot(real(pts), imag(pts), 'rx');
    axis equal; grid on;
    xlabel('In-phase'); ylabel('Quadrature'); title(names{ii});
end

%% Fig. 3 - received samples at Eb/N0 = 12 dB
figure;
for ii = 1:3
    M = Mset(ii); k = log2(M);
    pts = qammod((0:M-1)', M, 'UnitAveragePower', true);
    b  = randi([0 1], 2000*k, 1);
    tx = qammod(b, M, 'InputType','bit', 'UnitAveragePower', true);
    rx = awgn(tx, 12 + 10*log10(k), 'measured');   % Es/N0 = Eb/N0 + 10log10(k)
    subplot(1,3,ii);
    plot(real(rx), imag(rx), '.'); hold on;
    plot(real(pts), imag(pts), 'r.', 'MarkerSize', 12);
    axis equal; grid on;
    xlabel('In-phase'); ylabel('Quadrature'); title(names{ii});
end

%% BER simulation (uncoded, Gray, AWGN)
BER = zeros(3, numel(EbN0dB));
for ii = 1:3
    M = Mset(ii); k = log2(M);
    for jj = 1:numel(EbN0dB)
        nErr = 0; nBits = 0;
        while nErr < targetErrs && nBits < maxBits
            nThis = 12000*k;
            b  = randi([0 1], nThis, 1);
            tx = qammod(b, M, 'InputType','bit', 'UnitAveragePower', true);
            rx = awgn(tx, EbN0dB(jj) + 10*log10(k), 'measured');
            bhat = qamdemod(rx, M, 'OutputType','bit', 'UnitAveragePower', true);
            nErr  = nErr + sum(b ~= bhat);
            nBits = nBits + nThis;
        end
        BER(ii,jj) = nErr/nBits;
    end
end

%% Fig. 4 - BER: simulation (markers) and theory (lines)
figure;
x = 0:0.1:20;
for ii = 1:3
    semilogy(x, Pb(Mset(ii), 10.^(x/10)), col{ii}); hold on;
end
for ii = 1:3
    b = BER(ii,:); b(b == 0) = NaN;          % zero errors: not plotted
    semilogy(EbN0dB, b, [col{ii} mk{ii}]);
end
grid on; axis([0 20 3e-7 0.3]);
xlabel('E_b/N_0 (dB)'); ylabel('BER');
legend('QPSK (theory)','16-QAM (theory)','64-QAM (theory)', ...
       'QPSK (simulation)','16-QAM (simulation)','64-QAM (simulation)');

%% Fig. 5 - adaptive modulation, target BER = 1e-3
snr = 0:0.01:30;                              % Es/N0 in dB
tp = zeros(3, numel(snr));
for ii = 1:3
    M = Mset(ii); k = log2(M);
    ber = Pb(M, 10.^(snr/10)/k);              % Eb/N0 = (Es/N0)/k
    tp(ii,:) = k*(ber <= 1e-3);               % bit/s/Hz if target is met
end
figure;
plot(snr, tp(1,:), 'b--', snr, tp(2,:), 'g--', snr, tp(3,:), 'r--', ...
     snr, max(tp), 'k', 'LineWidth', 2);
grid on; xlabel('E_s/N_0 (dB)'); ylabel('Throughput (bit/s/Hz)');
legend('QPSK only','16-QAM only','64-QAM only','Adaptive','Location','northwest');

%% Fig. 6 - Gray-labelled 16-QAM
pts = qammod(0:15, 16, 'UnitAveragePower', true);
figure;
plot(real(pts), imag(pts), 'o', 'MarkerFaceColor', 'b'); hold on;
text(real(pts), imag(pts)+0.12, cellstr(dec2bin(0:15,4)), 'HorizontalAlignment','center');
axis equal; grid on; axis([-1.3 1.3 -1.3 1.3]);
xlabel('In-phase'); ylabel('Quadrature');

%% Fig. 7 - residual carrier phase error at Eb/N0 = 20 dB
phi = 0:2.5:20;                               % degrees
BERph = zeros(3, numel(phi));
for ii = 1:3
    M = Mset(ii); k = log2(M);
    b   = randi([0 1], 6e5, 1);               % 600000 bits (divisible by 2, 4 and 6)
    tx  = qammod(b, M, 'InputType','bit', 'UnitAveragePower', true);
    rx0 = awgn(tx, 20 + 10*log10(k), 'measured');
    for jj = 1:numel(phi)
        rx = rx0*exp(1j*phi(jj)*pi/180);      % rotate the received samples
        bhat = qamdemod(rx, M, 'OutputType','bit', 'UnitAveragePower', true);
        BERph(ii,jj) = sum(b ~= bhat)/numel(b);
    end
end
figure;
for ii = 1:3
    b = BERph(ii,:); b(b == 0) = NaN;
    semilogy(phi, b, ['-' col{ii} mk{ii}]); hold on;
end
grid on; axis([0 20 1e-6 1]);
xlabel('Residual carrier phase error (degrees)'); ylabel('BER');
legend('QPSK','16-QAM','64-QAM','Location','southeast');
